	keywords = {COVID-19, COVID-19 Vaccines, Clinical Trials as Topic, Coronavirus, Ethics, Human challenge studies, Humans, Randomized controlled trials, Research Design, Research design, SARS-CoV-2, Safety, Time Factors, Vaccines},
	pages = {372--377},
}

