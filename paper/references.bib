	author = {Halloran, M. Elizabeth and Auranen, Kari and Baird, Sarah and Basta, Nicole E. and Bellan, Steven E. and Brookmeyer, Ron and Cooper, Ben S. and DeGruttola, Victor and Hughes, James P. and Lessler, Justin and Lofgren, Eric T. and Longini, Ira M. and Onnela, Jukka-Pekka and Özler, Berk and Seage, George R. and Smith, Thomas A. and Vespignani, Alessandro and Vynnycky, Emilia and Lipsitch, Marc},
